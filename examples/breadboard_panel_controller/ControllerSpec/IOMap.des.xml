<Dessuite>
	<Core>
		<!-- Core settings -->
		<EventQueueSize>16</EventQueueSize>
		<Tasks>
			<TraceLoop>
				<Enabled>True</Enabled>
				<TraceQueueSize>32</TraceQueueSize>
				<CustomTraceClock>True</CustomTraceClock>
			</TraceLoop>
		</Tasks>
	</Core>
	<Modules>
		<!-- Module settings -->
		<CustomInclude>
			<Include>"main.h"</Include>
		</CustomInclude>
		<HalGpio>
			<PinSuffix>_Pin</PinSuffix>
			<PortSuffix>_GPIO_Port</PortSuffix>
		</HalGpio>
	</Modules>
	<Events>
		<!-- Button 1 Press Detection -->
		<Event>
			<Name>b1_press</Name>
			<Triggers>
				<HalGpio>
					<Interrupt>BUTTON_1</Interrupt>
				</HalGpio>
			</Triggers>
		</Event>
		<Event>
			<Name>b1_delay</Name>
			<Controllable/>
		</Event>
		<!-- LED W1 -->
		<Event>
			<Name>w1_turn_on</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Reset>LED_WHITE_1</Reset>
				</HalGpio>
			</Actions>
		</Event>
		<Event>
			<Name>w1_turn_off</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Set>LED_WHITE_1</Set>
				</HalGpio>
			</Actions>
		</Event>
		<!-- Cycle Control -->
		<Event>
			<Name>cycle_on_start</Name>
			<Controllable/>
		</Event>
		<Event>
			<Name>cycle_on_finish</Name>
			<Controllable/>
		</Event>
		<Event>
			<Name>cycle_off_start</Name>
			<Controllable/>
		</Event>
		<Event>
			<Name>cycle_off_finish</Name>
			<Controllable/>
		</Event>
		<!-- LED R1 -->
		<Event>
			<Name>r1_cycle_on</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Reset>LED_RED_1</Reset>
				</HalGpio>
			</Actions>
		</Event>
		<Event>
			<Name>r1_cycle_off</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Set>LED_RED_1</Set>
				</HalGpio>
			</Actions>
		</Event>
		<Event>
			<Name>r1_turn_off</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Set>LED_RED_1</Set>
				</HalGpio>
			</Actions>
		</Event>
		<!-- GREEN R1 -->
		<Event>
			<Name>g1_cycle_on</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Reset>LED_GREEN_1</Reset>
				</HalGpio>
			</Actions>
		</Event>
		<Event>
			<Name>g1_cycle_off</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Set>LED_GREEN_1</Set>
				</HalGpio>
			</Actions>
		</Event>
		<Event>
			<Name>g1_turn_off</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Set>LED_GREEN_1</Set>
				</HalGpio>
			</Actions>
		</Event>
	</Events>
</Dessuite>