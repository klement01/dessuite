<Dessuite>
	<Core>
		<!-- Core settings -->
		<EventQueueSize>8</EventQueueSize>
		<Tasks>
			<TraceLoop>
				<Enabled>True</Enabled>
				<TraceQueueSize>16</TraceQueueSize>
			</TraceLoop>
		</Tasks>
	</Core>
	<Modules>
		<!-- Module settings -->
		<HalGpio>
			<PinSuffix>_Pin</PinSuffix>
			<PortSuffix>_GPIO_Port</PortSuffix>
		</HalGpio>
		<HalUart>
			<Handle>huart1</Handle>
		</HalUart>
	</Modules>
	<Events>
		<Event>
			<Name>T1</Name>
			<Controllable/>
			<Actions>
				<HalUart>
					<Transmit>10</Transmit>
				</HalUart>
				<HalGpio>
					<Set>LED</Set>
				</HalGpio>
			</Actions>
		</Event>
		<Event>
			<Name>T2</Name>
			<Triggers>
				<HalUart>
					<Receive>20</Receive>
				</HalUart>
				<HalGpio>
					<Interrupt>BUTTON</Interrupt>
				</HalGpio>
			</Triggers>
		</Event>
	</Events>
</Dessuite>