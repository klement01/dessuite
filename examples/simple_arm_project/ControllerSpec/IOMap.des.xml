<Dessuite>
	<Core>
		<!-- Core settings -->
		<EventQueueSize>32</EventQueueSize>
	</Core>
	<Modules>
		<!-- Module settings -->
		<HalGpio>
			<PinSuffix>_Pin</PinSuffix>
			<PortSuffix>_GPIO_Port</PortSuffix>
		</HalGpio>
		<HalUart>
			<AutoEnumerate/>
			<Handle>huart1</Handle>
		</HalUart>
	</Modules>
	<Events>
		<!-- External event -->
		<Event>
			<Name>RED_BUTTON_PRESSED</Name>
			<Triggers>
				<HalGpio>
					<Interrupt>BUTTON_RED</Interrupt>
				</HalGpio>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<!-- Command -->
		<Event>
			<Name>DISABLE_GREEN_ENABLE_RED</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Set>LED_GREEN</Set>
					<Reset>LED_RED</Reset>
				</HalGpio>
				<HalUart>
					<Transmit/>
				</HalUart>
			</Actions>
		</Event>
		<!-- External event -->
		<Event>
			<Name>GREEN_BUTTON_PRESSED</Name>
			<Triggers>
				<HalGpio>
					<Interrupt>BUTTON_GREEN</Interrupt>
				</HalGpio>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<!-- Command -->
		<Event>
			<Name>ENABLE_GREEN_DISABLE_RED</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Reset>LED_GREEN</Reset>
					<Set>LED_RED</Set>
				</HalGpio>
				<HalUart>
					<Transmit/>
				</HalUart>
			</Actions>
		</Event>
	</Events>
</Dessuite>