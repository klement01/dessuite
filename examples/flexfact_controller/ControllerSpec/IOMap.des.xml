<Dessuite>
	<Core>
		<!-- Core settings -->
		<EventQueueSize>32</EventQueueSize>
	</Core>
	<Modules>
		<!-- Module settings -->
		<HalGpio>
			<PinSuffix>_Pin</PinSuffix>
			<PortSuffix>_GPIO_Port</PortSuffix>
		</HalGpio>
		<HalUart>
			<AutoEnumerate/>
			<Handle>huart1</Handle>
		</HalUart>
	</Modules>
	<Events>
		<!-- External events -->
		<Event>
			<Name>sf1_fdhome</Name>
			<Triggers>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<Event>
			<Name>sf1_wpar</Name>
			<Triggers>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<Event>
			<Name>sf1_wplv</Name>
			<Triggers>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<Event>
			<Name>cb1_wpar</Name>
			<Triggers>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<Event>
			<Name>cb1_wplv</Name>
			<Triggers>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<Event>
			<Name>xs1_wpar</Name>
			<Triggers>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<Event>
			<Name>xs1_wplv</Name>
			<Triggers>
				<HalUart>
					<Receive/>
				</HalUart>
			</Triggers>
		</Event>
		<!-- Commands -->
		<Event>
			<Name>sf1_fdon</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Reset>LED_RED_1</Reset>
				</HalGpio>
				<HalUart>
					<Transmit/>
				</HalUart>
			</Actions>
		</Event>
		<Event>
			<Name>sf1_fdoff</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Set>LED_RED_1</Set>
				</HalGpio>
				<HalUart>
					<Transmit/>
				</HalUart>
			</Actions>
		</Event>
		<Event>
			<Name>cb1_bm+</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Reset>LED_RED_2</Reset>
				</HalGpio>
				<HalUart>
					<Transmit/>
				</HalUart>
			</Actions>
		</Event>
		<Event>
			<Name>cb1_boff</Name>
			<Controllable/>
			<Actions>
				<HalGpio>
					<Set>LED_RED_2</Set>
				</HalGpio>
				<HalUart>
					<Transmit/>
				</HalUart>
			</Actions>
		</Event>
	</Events>
</Dessuite>