/** Petri Net variables and update functions. **/

struct Place corePlaces[CORE_PLACE_COUNT] = { {CORE_INITIAL_MARKINGS} };
TickType_t transitionEnabledTime[CORE_EVENT_COUNT] = { 0 };

bool NetIsTransitionStructurallyEnabled(EventIdx_t eventIdx)
{
  for (int8_t idx = 0; idx < CORE_EVENT_TRANSITIONS[eventIdx].inhibitorArcsCount; ++idx)
  {
    const PlaceIdx_t arcPlace = CORE_EVENT_TRANSITIONS[eventIdx].inhibitorArcs[idx].placeIdx;
    const ArcWeight_t arcWeight = CORE_EVENT_TRANSITIONS[eventIdx].inhibitorArcs[idx].weight;
    if (corePlaces[arcPlace].markings >= arcWeight)
      return false;
  }

  for (int8_t idx = 0; idx < CORE_EVENT_TRANSITIONS[eventIdx].inputArcsCount; ++idx)
  {
    const PlaceIdx_t arcPlace = CORE_EVENT_TRANSITIONS[eventIdx].inputArcs[idx].placeIdx;
    const ArcWeight_t arcWeight = CORE_EVENT_TRANSITIONS[eventIdx].inputArcs[idx].weight;
    if (arcWeight > corePlaces[arcPlace].markings)
      return false;
  }

  return true;
}

bool NetIsTransitionEnabled(EventIdx_t eventIdx, TickType_t tick)
{
  if (transitionEnabledTime[eventIdx] == portMAX_DELAY)
    return false;

  const TickType_t timeElapsed = tick - transitionEnabledTime[eventIdx];
  return (CORE_EVENT_TRANSITIONS[eventIdx].intervalLowerLimit <= timeElapsed)
    && (timeElapsed <= CORE_EVENT_TRANSITIONS[eventIdx].intervalUpperLimit);
}

void NetUpdateTransitionEnabledTime(EventIdx_t eventIdx, TickType_t tick)
{
    if (NetIsTransitionStructurallyEnabled(eventIdx))
    {
      if (transitionEnabledTime[eventIdx] == portMAX_DELAY)
        transitionEnabledTime[eventIdx] = tick;
    }
    else
    {
      transitionEnabledTime[eventIdx] = portMAX_DELAY;
    }
}

bool NetTryUpdate(EventIdx_t eventIdx, TickType_t tick)
{
  if (!NetIsTransitionEnabled(eventIdx, tick))
    return false;

  for (int8_t idx = 0; idx < CORE_EVENT_TRANSITIONS[eventIdx].deltaArcsCount; ++idx)
  {
    const PlaceIdx_t placeIdx = CORE_EVENT_TRANSITIONS[eventIdx].deltaArcs[idx].placeIdx;
    const ArcWeight_t weight = CORE_EVENT_TRANSITIONS[eventIdx].deltaArcs[idx].weight;
    corePlaces[placeIdx].markings += weight;
  }

  for (int8_t idx = 0; idx < CORE_EVENT_TRANSITIONS[eventIdx].affectedTransitionsCount; ++idx)
    NetUpdateTransitionEnabledTime(CORE_EVENT_TRANSITIONS[eventIdx].affectedTransitions[idx], tick);

  return true;
}

bool NetGetNextEnabledCommand(TickType_t currentTick, struct RichCommand *command)
{
  command->tick = portMAX_DELAY;

  for (CommandIdx_t commandIdx = 0; commandIdx < CORE_COMMAND_COUNT; ++commandIdx)
  {
    const EventIdx_t eventIdx = CORE_COMMANDS[commandIdx].eventIdx;

    if (transitionEnabledTime[eventIdx] == portMAX_DELAY)
      continue;

    if (CORE_EVENT_TRANSITIONS[eventIdx].intervalUpperLimit != portMAX_DELAY
      && currentTick > transitionEnabledTime[eventIdx] + CORE_EVENT_TRANSITIONS[eventIdx].intervalUpperLimit)
      continue;

    const TickType_t commandEnabledTick = transitionEnabledTime[eventIdx] + CORE_EVENT_TRANSITIONS[eventIdx].intervalLowerLimit;
    if (command->tick == portMAX_DELAY || commandEnabledTick < command->tick)
    {
      command->idx = commandIdx;
      command->tick = commandEnabledTick;
    }
  }

  return command->tick != portMAX_DELAY;
}


/** Core variables, tasks and helper functions. **/

TaskHandle_t TaskLoopHandleNetUpdatesHandle;
TaskHandle_t TaskLoopHandleIncomingEventsHandle;
TimerHandle_t TimerOneshotExecuteOutgoingCommandHandle;
QueueHandle_t OutgoingCommandQueue;
SemaphoreHandle_t NetMutex;

void NetLock()
{
  configASSERT(pdTRUE == xSemaphoreTake(NetMutex, portMAX_DELAY));
}

void NetRelease()
{
  configASSERT(pdTRUE == xSemaphoreGive(NetMutex));
}

void DoExecuteCommand(CommandIdx_t commandIdx)
{
  NetLock();
  const bool netUpdated = NetTryUpdate(CORE_COMMANDS[commandIdx].eventIdx, xTaskGetTickCount());
  NetRelease();

  if (netUpdated)
    CORE_COMMANDS[commandIdx].handler();
}

void TaskLoopHandleNetUpdates(void*)
{
  {
    // Initialize Petri Net.
    TickType_t startTick = xTaskGetTickCount();
    for (EventIdx_t eventIdx = 0; eventIdx < CORE_EVENT_COUNT; ++eventIdx)
      NetUpdateTransitionEnabledTime(eventIdx, startTick);

    // Notify task of Petri Net initialization.
    configASSERT(pdPASS == xTaskNotify(TaskLoopHandleIncomingEventsHandle, 0, eNoAction));

    // Set priority for timer task (TimerOneshotExecuteOutgoingCommand).
    vTaskPrioritySet(xTimerGetTimerDaemonTaskHandle(), CORE_EXECUTE_OUTGOING_COMMAND_PRIORITY);
  }

  for (;;)
  {
    struct RichCommand nextEnabledCommand;

    NetLock();
    const bool foundEnabledCommand = NetGetNextEnabledCommand(xTaskGetTickCount(), &nextEnabledCommand);
    NetRelease();

    bool waitForNetUpdate = true;
    
    if (foundEnabledCommand)
    {
      // Send or schedule next enabled command.
      const TickType_t currentTick = xTaskGetTickCount();
      if (nextEnabledCommand.tick > currentTick)
      {
        // Command isn't enabled yet; schedule execution.
        const TickType_t period = nextEnabledCommand.tick - currentTick;
        configASSERT(pdPASS == xQueueOverwrite(OutgoingCommandQueue, &nextEnabledCommand.idx));
        configASSERT(pdPASS == xTimerChangePeriod(TimerOneshotExecuteOutgoingCommandHandle, period, portMAX_DELAY));
        configASSERT(pdPASS == xTimerStart(TimerOneshotExecuteOutgoingCommandHandle, portMAX_DELAY));
      }
      else
      {
        // Command is already enabled; temporarily change priority and execute.
        vTaskPrioritySet(NULL, CORE_EXECUTE_OUTGOING_COMMAND_PRIORITY);
        DoExecuteCommand(nextEnabledCommand.idx);
        vTaskPrioritySet(NULL, CORE_HANDLE_NET_UPDATES_PRIORITY);
        waitForNetUpdate = false;
      }
    }

    // Wait for Petri Net update and cancel scheduled command, if any.
    if (waitForNetUpdate)
    {
      ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
      configASSERT(pdPASS == xTimerStop(TimerOneshotExecuteOutgoingCommandHandle, portMAX_DELAY));
    }
  }
}

void TaskLoopHandleIncomingEvents(void*)
{
  // Wait for Petri Net initialization from TaskLoopHandleNetUpdates.
  ulTaskNotifyTake(pdTRUE, portMAX_DELAY);

  for (;;)
  {
    struct RichEvent event;
    configASSERT(pdPASS == xQueueReceive(IncomingEventsQueue, &event, portMAX_DELAY));

    NetLock();
    const bool netUpdated = NetTryUpdate(event.idx, event.tick);
    NetRelease();

    if (netUpdated)
      configASSERT(pdPASS == xTaskNotify(TaskLoopHandleNetUpdatesHandle, 0, eNoAction));
  }
}

void TimerOneshotExecuteOutgoingCommand(TimerHandle_t timerHandle)
{
    if (timerHandle != TimerOneshotExecuteOutgoingCommandHandle)
      // Prevent execution by user code.
      return;

    CommandIdx_t commandIdx;
    configASSERT(pdPASS == xQueueReceive(OutgoingCommandQueue, &commandIdx, 0));
    DoExecuteCommand(commandIdx);
    configASSERT(pdPASS == xTaskNotify(TaskLoopHandleNetUpdatesHandle, 0, eNoAction));
}


/** Initialization function. Called by user code. **/

void DesControllerSetup(void)
{
  /* Core initialization. */
  configASSERT(NULL != (NetMutex = xSemaphoreCreateMutex()));
  configASSERT(NULL != (IncomingEventsQueue = xQueueCreate(CORE_EVENT_QUEUE_SIZE, sizeof(struct RichEvent))));
  configASSERT(NULL != (OutgoingCommandQueue = xQueueCreate(1, sizeof(CommandIdx_t))));

  configASSERT(pdPASS == xTaskCreate(TaskLoopHandleNetUpdates, CORE_HANDLE_NET_UPDATES_NAME, CORE_HANDLE_NET_UPDATES_SDEPTH, NULL, CORE_HANDLE_NET_UPDATES_PRIORITY, &TaskLoopHandleNetUpdatesHandle));
  configASSERT(pdPASS == xTaskCreate(TaskLoopHandleIncomingEvents, CORE_HANDLE_INCOMING_EVENTS_NAME, CORE_HANDLE_INCOMING_EVENTS_SDEPTH, NULL, CORE_HANDLE_INCOMING_EVENTS_PRIORITY, &TaskLoopHandleIncomingEventsHandle));
  configASSERT(NULL != (TimerOneshotExecuteOutgoingCommandHandle = xTimerCreate(CORE_EXECUTE_OUTGOING_COMMAND_NAME, portMAX_DELAY, pdFALSE, NULL, TimerOneshotExecuteOutgoingCommand)));

  /* Module initialization. */
{MODULE_INIT_FUNCTION_CALLS}
}
